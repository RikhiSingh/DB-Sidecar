DATABASE_URL=postgresql://admin:admin@localhost:5432/feytra
OPENAI_API_KEY="sk-"
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
EMBED_PROVIDER=openai

SIDECAR_DB=./data/sidecar.sqlite
EMBED_DIM=768
VECTOR_BACKEND=hnsw
QDRANT_URL=http://localhost:6333
POLL_INTERVAL_SECS=300
ENABLE_NOTIFY=true
NOTIFY_CHANNEL=feytra_ddl
INSTALL_PG_EVENT_TRIGGER=false
BOOTSTRAP_ON_START=true
SAMPLE_ROWS=200
MASKING_RULES=email=.email.,name=.name.
PORT=8080
RUST_LOG=info,sidecar=debug